{
  "name": "Sadik Travels Admin Console",
  "short_name": "Sadik Admin",
  "description": "Operations console for Sadik Travels: manage bookings, hotels, tours, catalogue, payments and customer care.",
  "id": "/admin/",
  "start_url": "/admin/?source=pwa",
  "scope": "/admin/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "theme_color": "#1438b8",
  "background_color": "#f5f7fb",
  "lang": "en",
  "dir": "ltr",
  "categories": ["business", "productivity", "travel"],
  "icons": [
    { "src": "/assets/admin-icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/assets/admin-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/assets/admin-icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "prefer_related_applications": false,
  "shortcuts": [
    { "name": "Dashboard", "short_name": "Dashboard", "description": "Open the admin dashboard", "url": "/admin/", "icons": [{ "src": "/assets/admin-icon-192.png", "sizes": "192x192" }] },
    { "name": "Hotel Bookings", "short_name": "Hotels", "description": "Manage hotel bookings", "url": "/admin/hotel-bookings", "icons": [{ "src": "/assets/admin-icon-192.png", "sizes": "192x192" }] },
    { "name": "Bookings", "short_name": "Bookings", "description": "Manage customer bookings", "url": "/admin/bookings", "icons": [{ "src": "/assets/admin-icon-192.png", "sizes": "192x192" }] },
    { "name": "Live Support", "short_name": "Support", "description": "Answer live chat conversations", "url": "/admin/live-support", "icons": [{ "src": "/assets/admin-icon-192.png", "sizes": "192x192" }] }
  ]
}
