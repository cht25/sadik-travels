NODE_ENV=development
PORT=8787
HOST=0.0.0.0
APP_ORIGIN=http://localhost:8787
CORS_ORIGINS=http://localhost:8787
TRUST_PROXY=false
SERVE_STATIC=true
# MongoDB Atlas or another managed MongoDB-compatible cluster
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.example.mongodb.net/sadik_travels?retryWrites=true&w=majority

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=sadik-travels-api
JWT_AUDIENCE=sadik-travels-web
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ADMIN_IDENTITIES=
# Optional non-interactive first-run bootstrap. Set only in your deployment secret store.
# The application creates the super admin once and never overwrites an existing password.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SETTINGS_MASTER_KEY=replace-with-another-32-character-secret

# Firebase Authentication — enables "Continue with Google" admin sign-in.
# Server credentials (service account; required to verify Google ID tokens):
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Public web config (safe to expose to the browser):
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Persistent media storage (required in production)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MEDIA_MAX_UPLOAD_BYTES=8388608
MEDIA_TIMEOUT_MS=15000

# Payment gateway (SSLCommerz / bKash credentials are configured in Admin → Settings)
PAYMENT_MODE=live
PAYMENT_PROVIDER_BASE_URL=
PAYMENT_PROVIDER_API_KEY=
PAYMENT_WEBHOOK_SECRET=
# Timeout for outbound provider calls (SMS, payment, SMTP)
OUTBOUND_TIMEOUT_MS=12000

# SMS gateway (configure a real provider; leave blank for local DEV_OTP_ECHO)
SMS_PROVIDER=custom_gateway
SMS_GATEWAY_URL=
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=

# BulkSMSBD fallback
BULKSMSBD_API_URL=https://bulksmsbd.net/api/smsapi
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=

# SMTP email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Local development only; set false for production
DEV_OTP_ECHO=true
LOG_LEVEL=info
