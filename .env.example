# Runtime
NODE_ENV=development
PORT=8787
HOST=0.0.0.0
APP_ORIGIN=http://localhost:8787
CORS_ORIGINS=http://localhost:8787
TRUST_PROXY=false
SERVE_STATIC=true
PUBLIC_DIR=public

# Security — replace every value before production
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=sadik-travels-api
JWT_AUDIENCE=sadik-travels-web
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Comma-separated normalized phone/email identities allowed to administer the CMS.
ADMIN_IDENTITIES=

# Data — production requires managed MongoDB and Redis
DATA_MODE=mongodb
MONGODB_URI=mongodb://127.0.0.1:27017/sadik_travels
REDIS_URL=redis://localhost:6379

# Persistent image storage — required in production. Images are stored in Cloudinary, never locally.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=sadik-travels
MAX_UPLOAD_BYTES=5242880

# Live travel provider adapter. The generic adapter expects /v1/{vertical}/search and booking endpoints;
# adapt src/providers.ts to your supplier's authenticated contract when it differs.
TRAVEL_PROVIDER_BASE_URL=
TRAVEL_PROVIDER_API_KEY=
TRAVEL_PROVIDER_TIMEOUT_MS=12000

# Live payment gateway and signed webhook
PAYMENT_PROVIDER_BASE_URL=
PAYMENT_PROVIDER_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# BulkSMSBD transactional OTP and notifications
BULKSMSBD_API_URL=https://bulksmsbd.net/api/smsapi
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=

# SMTP email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Development only. Never enable in production.
DEV_OTP_ECHO=false
LOG_LEVEL=info
