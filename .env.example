NODE_ENV=development
PORT=8787
HOST=0.0.0.0
APP_ORIGIN=http://localhost:8787
CORS_ORIGINS=http://localhost:8787
TRUST_PROXY=false
SERVE_STATIC=true
# MongoDB Atlas or another managed MongoDB-compatible cluster
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.example.mongodb.net/sadik_travels?retryWrites=true&w=majority

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=sadik-travels-api
JWT_AUDIENCE=sadik-travels-web
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ADMIN_IDENTITIES=
# Optional non-interactive first-run bootstrap. Set only in your deployment secret store.
# The application creates the super admin once and never overwrites an existing password.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SETTINGS_MASTER_KEY=replace-with-another-32-character-secret

# Firebase Authentication — enables "Continue with Google" admin sign-in.
# Server credentials (service account; required to verify Google ID tokens):
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Public web config (safe to expose to the browser):
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Firebase Realtime Database — live chat (messenger-style conversations).
# When the service account above is configured, the browser connects DIRECTLY
# to Realtime Database for the live message stream: the server mints a Firebase
# custom token per signed-in visitor/staff member, and database.rules.json
# (this repository) restricts every read/write to conversation participants.
# Leave blank to use the project default (https://<FIREBASE_PROJECT_ID>-default-rtdb.firebaseio.com).
# Without these credentials chat stores transcripts in MongoDB and fans out in
# real time over Socket.IO (still push-based, never polling).
#
# REQUIRED RULES — publish database.rules.json from this repository to your
# Firebase project (Firebase console → Realtime Database → Rules, or
# `firebase deploy --only database`). Never run chat with open rules.
FIREBASE_DATABASE_URL=

# Persistent media storage (required in production)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MEDIA_MAX_UPLOAD_BYTES=8388608
MEDIA_TIMEOUT_MS=15000

# Payment gateway (SSLCommerz / bKash credentials are configured in Admin → Settings)
PAYMENT_MODE=live
PAYMENT_PROVIDER_BASE_URL=
PAYMENT_PROVIDER_API_KEY=
PAYMENT_WEBHOOK_SECRET=
# Timeout for outbound provider calls (SMS, payment, SMTP)
OUTBOUND_TIMEOUT_MS=12000

# SMS gateway (configure a real provider; leave blank for local DEV_OTP_ECHO)
SMS_PROVIDER=custom_gateway
SMS_GATEWAY_URL=
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=

# BulkSMSBD fallback
BULKSMSBD_API_URL=https://bulksmsbd.net/api/smsapi
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=

# SMTP email notifications.
# Credentials come from the environment (or Admin -> Settings, stored encrypted).
# They are never sent to the browser. SMTP is used for EMAIL ONLY — device push
# notifications use Web Push (VAPID) below and never touch SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Display name for the From: header, e.g. "Sadik Travels"
SMTP_FROM_NAME=Sadik Travels
# Force implicit TLS. Auto-enabled for port 465; port 587 upgrades via STARTTLS.
SMTP_SECURE=
# Reject unsigned certificates. Defaults to true in production.
SMTP_REJECT_UNAUTHORIZED=

# Web Push (VAPID) — real phone/desktop push notifications.
# Generate a pair once with:  npx web-push generate-vapid-keys
# Leave both blank to let the server generate and persist a pair in MongoDB on
# first start. The PRIVATE key is stored encrypted and never leaves the server;
# only the public key is exposed to the browser so it can subscribe.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the push service; a mailto: or https: URL.
VAPID_SUBJECT=

# Password reset: single-use, hashed, expiring tokens.
PASSWORD_RESET_TTL_MINUTES=30

# Optional approximate IP geolocation for new-device security alerts.
# The URL must contain the {ip} placeholder and use HTTPS. The result is always
# labelled "approximate" — it is an estimate from network information, never an
# exact location. Leave blank to omit location from security emails.
# Example (ipinfo.io): https://ipinfo.io/{ip}/json
IP_GEO_URL=
IP_GEO_TOKEN=

# Tour surcharge defaults. ZERO means "no charge unless an operator opts in"
# per tour (metadata.vatPct / aitPct) or in Admin -> Settings. An implicit 20%
# tax on every package was one cause of the 6,000 -> 14,400 overcharge.
TOUR_VAT_PCT=0
TOUR_AIT_PCT=0
TOUR_SERVICE_FEE_PCT=0

# Local development only; set false for production
DEV_OTP_ECHO=true
LOG_LEVEL=info
