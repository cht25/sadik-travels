{
  "name": "sadik-travels",
  "version": "1.0.0",
  "private": true,
  "description": "Sadik Travels single-process Node.js travel platform",
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "audit": "npm audit --omit=dev --audit-level=high",
    "admin:create": "tsx src/admin-create.ts",
    "cleanup:legacy": "tsx src/cleanup-legacy.ts",
    "test": "npm run build && node --test dist/smoke.test.js dist/chat.test.js dist/hotel-images.test.js",
    "demo": "tsx src/demo-server.ts"
  },
  "dependencies": {
    "@types/express": "^5.0.3",
    "@types/nodemailer": "^6.4.16",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.1.0",
    "jose": "^6.0.11",
    "mongoose": "^8.24.3",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "pino": "^9.7.0",
    "pino-http": "^10.4.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.15.30",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
