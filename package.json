{
  "name": "sadik-travels-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Production-oriented MongoDB API for Sadik Travels and Go Get Tour",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test dist/smoke.test.js",
    "smoke": "npm run build && node dist/smoke.test.js",
    "db:indexes": "node dist/create-indexes.js"
  },
  "dependencies": {
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.4.1",
    "jose": "^6.0.11",
    "mongoose": "^8.18.1",
    "nodemailer": "^9.0.5",
    "pino": "^9.7.0",
    "pino-http": "^10.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "@types/nodemailer": "^6.4.16",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
